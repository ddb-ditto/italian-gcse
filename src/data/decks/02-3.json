  "notes": [
    {
      "lead": "What these cannot test",
      "body": "The whole session is about feeling why lo exists, and no card can make a mouth uncomfortable. Before drilling these, have them say il studente aloud three times, fast. The cards are for afterwards."
    }
  ],
  "cards": [
    {
      "d": "The rule",
      "t": "rule",
      "f": "When does il become lo?",
      "m": "Before s + another consonant, and before z, gn, ps and y — the clusters the mouth cannot easily start after l."
    },
    {
      "d": "The rule",
      "t": "rule",
      "f": "Why is it lo zucchero and not il zucchero?",
      "m": "Because z is really two sounds, ts. It is a consonant cluster like st or sp."
    },
    {
      "d": "The rule",
      "t": "rule",
      "f": "Is it il sole or lo sole?",
      "m": "il sole. The s is followed by a vowel, so there is no cluster and nothing to fix."
    },
