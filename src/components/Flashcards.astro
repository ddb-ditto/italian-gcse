---
/**
 * A deck page's study app and its printable sheets.
 *
 * The cards are handed to the browser as JSON and the behaviour comes from one
 * bundled module, so adding a deck adds data — not another copy of the app.
 */
import type { Card } from "../scripts/flashcards";

interface Props { cards: Card[]; noReverse?: string[]; }
const { cards, noReverse = [] } = Astro.props;
---

<div class="app noprint">

  <div class="decks" id="decks" role="group" aria-label="Choose decks"></div>

  <div class="card" id="card" tabindex="0" role="button" aria-live="polite">
    <span class="decktag" id="decktag"></span>
    <div id="face"></div>
    <span class="hint" id="hint">Tap, click or press space to turn over</span>
  </div>

  <div class="controls">
    <button class="arrow" id="prev" aria-label="Previous card">
      <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 5 8 12 15 19" /></svg>
    </button>
    <span class="position" id="position"></span>
    <button class="arrow" id="next" aria-label="Next card">
      <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 5 16 12 9 19" /></svg>
    </button>
  </div>

  <div class="meta">
    <span></span>
    <span>
      <span id="reversewrap" hidden>
        <label><input type="checkbox" id="reverse" /> English first</label>
        &nbsp;·&nbsp;
      </span>
      <button id="shuffle">Shuffle</button>
      &nbsp;·&nbsp;
      <button id="printit">Print cards</button>
    </span>
  </div>

</div>

<div class="printsheets" id="printsheets"></div>

<script type="application/json" id="cards-data" set:html={JSON.stringify(cards)} is:inline />
<script type="application/json" id="no-reverse" set:html={JSON.stringify(noReverse)} is:inline />
<script>
  import "../scripts/flashcards";
</script>

<style>
  /* =========================================================================
     Flashcard app — screen
     ====================================================================== */

  .app { max-width: 44rem; margin: 0 auto; }

  .decks { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0 0 1.2rem; }

  /* The chips are created by the script, so they never get the scope
     attribute an element written in this file would. Hanging each rule off
     .decks — which is in the markup above and does get it — keeps them
     contained without relying on a class name being unique site-wide. */
  .decks :global(.chip) {
    font-family: var(--sans); font-size: 0.82rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--rule); border-radius: 999px;
    background: var(--card); color: var(--ink-soft);
    cursor: pointer; line-height: 1.2;
  }
  .decks :global(.chip:hover) { border-color: var(--accent); color: var(--accent); }
  .decks :global(.chip[aria-pressed="true"]) {
    background: var(--accent); border-color: var(--accent); color: #fff;
  }
  .decks :global(.chip .n) { opacity: 0.65; font-size: 0.76rem; margin-left: 0.35rem; }

  .card {
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: 6px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05), 0 8px 24px rgba(0,0,0,0.05);
    min-height: 15rem;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    text-align: center;
    padding: 2rem 1.6rem;
    cursor: pointer; user-select: none; position: relative;
  }
  .card:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .decktag {
    position: absolute; top: 0.85rem; left: 0; right: 0;
    font-family: var(--sans); font-size: 0.62rem;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-faint);
  }
  .card :global(.term) {
    font-size: clamp(1.7rem, 6vw, 2.6rem);
    font-style: italic; line-height: 1.2; margin: 0;
  }
  .card :global(.term.q) {
    font-style: normal; font-family: var(--sans); font-weight: 500;
    font-size: clamp(1.1rem, 3.6vw, 1.45rem); max-width: 26rem;
  }
  .card :global(.answer) { max-width: 28rem; }
  .card :global(.answer .say) {
    font-family: var(--sans); font-size: 0.92rem; color: var(--accent);
    margin: 0 0 0.6rem; letter-spacing: 0.02em;
  }
  .card :global(.answer .meaning) { font-size: 1.12rem; margin: 0; }
  .hint {
    position: absolute; bottom: 0.85rem; left: 0; right: 0;
    font-family: var(--sans); font-size: 0.68rem; color: var(--ink-faint);
  }

  .controls {
    display: flex; align-items: center; justify-content: center;
    gap: 1rem; margin: 1rem 0 0.2rem;
  }
  .arrow {
    width: 3.4rem; height: 3.4rem; flex: none;
    border: 1px solid var(--rule); background: var(--card); color: var(--ink);
    border-radius: 50%; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
  }
  .arrow:hover { border-color: var(--accent); color: var(--accent); }
  .arrow:active { background: var(--accent-soft); }
  .arrow svg {
    width: 1.1rem; height: 1.1rem;
    fill: none; stroke: currentColor; stroke-width: 2;
  }
  .position {
    font-family: var(--sans); font-size: 0.9rem; color: var(--ink-soft);
    min-width: 5rem; text-align: center; font-variant-numeric: tabular-nums;
  }
  .position :global(.of) { color: var(--ink-faint); }

  .meta {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;
    font-family: var(--sans); font-size: 0.78rem; color: var(--ink-faint);
    margin-top: 0.8rem;
  }
  .meta button {
    font: inherit; background: none; border: none; color: var(--ink-faint);
    cursor: pointer; text-decoration: underline; padding: 0;
  }
  .meta label { display: inline-flex; align-items: center; gap: 0.35rem; cursor: pointer; }

  /* =========================================================================
     Print — 8 fold-over cards per A4
     ====================================================================== */

  .printsheets { display: none; }

  @media print {
    .app { display: none !important; }
    .printsheets { display: block; }
    @page { size: A4; margin: 12mm; }

    .printsheets :global(.sheet) {
      break-after: page; page-break-after: always; width: 100%;
    }
    .printsheets :global(.sheet:last-child) { break-after: auto; page-break-after: auto; }

    .printsheets :global(.prow) {
      display: flex; height: 33mm;
      border-bottom: 0.4pt solid #999;
      break-inside: avoid; page-break-inside: avoid;
    }
    .printsheets :global(.sheet .prow:first-child) { border-top: 0.4pt solid #999; }

    .printsheets :global(.pcell) {
      width: 50%; padding: 3mm 4mm;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      text-align: center; overflow: hidden;
    }
    .printsheets :global(.pfront) { border-right: 0.4pt dashed #bbb; }
    .printsheets :global(.pdeck) {
      font-family: var(--sans); font-size: 5pt;
      letter-spacing: 0.14em; text-transform: uppercase; color: #777;
      margin-bottom: 1.5mm;
    }
    .printsheets :global(.pterm) { font-style: italic; font-size: 13pt; line-height: 1.15; }
    .printsheets :global(.pterm.q) {
      font-style: normal; font-family: var(--sans); font-size: 8pt; line-height: 1.25;
    }
    .printsheets :global(.psay) {
      font-family: var(--sans); font-size: 7pt; color: #7a2e1e; margin-bottom: 1mm;
    }
    .printsheets :global(.pmeaning) { font-size: 8.5pt; line-height: 1.25; }
  }
</style>
